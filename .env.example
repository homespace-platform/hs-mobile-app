EXPO_PUBLIC_KEYCLOAK_BASE_URL=http://localhost:9000
EXPO_PUBLIC_KEYCLOAK_REALM=homespace-platform
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=homespace-id
EXPO_PUBLIC_GATEWAY_BASE_URL=http://localhost:8080
# Android Studio emulator only. Leave empty for physical devices / adb reverse.
EXPO_PUBLIC_ANDROID_API_HOST=10.0.2.2
# Optional. Public web origin for the "Sao chép liên kết" profile button (hidden when empty).
EXPO_PUBLIC_WEB_BASE_URL=
# Optional. The app's OWN Origin for the realtime notification socket (not the web URL). Must also be added to
# NOTIFICATION_REALTIME_ORIGINS in hs-notification-service. Empty = socket off (push + REST still work).
EXPO_PUBLIC_REALTIME_ORIGIN=
