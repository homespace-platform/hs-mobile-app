    "test:membership": "node --test tests/membership-screen.test.cjs",
    "test:chat":"node --test tests/chat-threads.test.cjs tests/chat-document-transfer.test.mjs",
    "test:push": "node --test tests/push-realtime.test.cjs",
    "test:pagination": "node --test tests/pagination.test.cjs",
    "test:presence": "node --test tests/presence.test.cjs",
    "test:kyc": "node --test tests/kyc.test.cjs",
