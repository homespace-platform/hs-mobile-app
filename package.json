    "test:rental-api": "node --test tests/rental-api.test.cjs",
    "test:rental-logic": "node --test tests/rental-logic.test.cjs",
    "test:rental-money": "node --test --test-isolation=none tests/rental-money.test.cjs",
    "test:rental-ui": "node --test tests/rental-ui.test.cjs",
    "test:rental-nav": "node --test tests/rental-nav.test.cjs",
    "test:rental-requests": "node --test tests/rental-requests.test.cjs",
    "test:rental-contract-signing": "node --test tests/rental-contract-signing.test.cjs",
    "test:rental-billing": "node --test tests/rental-billing.test.cjs",
