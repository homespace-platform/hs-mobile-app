    "test:listing-editor": "node --test tests/listing-editor.test.cjs",
    "test:health": "node --test tests/backend-health.test.cjs",
    "test:network": "node --test tests/network-health.test.cjs",
    "run:android": "expo run:android --port 4000",
    "prerun:android": "npm run android:connect",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web --port 4000"
